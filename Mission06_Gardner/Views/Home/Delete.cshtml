
@model Movie

@{
    ViewData["Title"] = "Delete Movie";
}


<h2>Confirm Deletion</h2>
<h3>@Model.Title</h3>
<form asp-controller="Home" asp-action="Delete" method="post">
    <input type="hidden" asp-for="MovieId"></input>
    <button type="submit">Delete?</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="ShowMovies">Cancel</a>
</form>