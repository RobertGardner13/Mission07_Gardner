@model List<Mission06_Gardner.Models.Movie>

@{
    ViewData["Title"] = "Show Movies";
}

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary fw-bold">🎬 Movie Collection</h2>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover shadow-sm rounded">
            <thead class="table-dark text-center">
                <tr>
                    <th>Category</th>
                    <th>Title</th>
                    <th>Year</th>
                    <th>Director</th>
                    <th>Rating</th>
                    <th>Edited</th>
                    <th>Lent To</th>
                    <th>Copied To Plex</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <!-- Null check for Category -->
                        <td>@(x.Category != null ? x.Category.CategoryName : "No Category")</td>
                        <td class="fw-semibold">@x.Title</td>
                        <td>@x.Year</td>
                        <td>@x.Director</td>
                        <td><span class="badge bg-info text-dark">@x.Rating</span></td>
                        <td>
                            <span class="badge @(x.Edited.HasValue && x.Edited.Value == 1 ? "bg-success" : "bg-danger")">
                                @(x.Edited.HasValue ? (x.Edited.Value == 1 ? "Yes" : "No") : "N/A")
                            </span>
                        </td>
                        <td>@x.LentTo</td>
                        <td>
                            <span class="badge @(x.CopiedToPlex.HasValue && x.CopiedToPlex.Value == 1 ? "bg-success" : "bg-danger")">
                                @(x.CopiedToPlex.HasValue ? (x.CopiedToPlex.Value == 1 ? "Yes" : "No") : "N/A")
                            </span>
                        </td>
                        <td>@x.Notes</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-outline-warning" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">
                                ✏️ Edit
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">
                                🗑️ Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

